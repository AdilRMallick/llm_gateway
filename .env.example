# Copy to .env. Nothing here is required to run the mock-provider stack.
GATEWAY_DATABASE_URL=postgresql+asyncpg://gateway:gateway@postgres:5432/gateway
GATEWAY_REDIS_URL=redis://redis:6379/0

# Point adapters at the mock provider service (default for local + CI).
# Unset these to hit the real provider APIs.
GATEWAY_ANTHROPIC_BASE_URL=http://mock-provider:9000/anthropic
GATEWAY_OPENAI_BASE_URL=http://mock-provider:9000/openai
GATEWAY_GOOGLE_BASE_URL=http://mock-provider:9000/google

# Real keys, only needed when the base URLs above are unset.
GATEWAY_ANTHROPIC_API_KEY=
GATEWAY_OPENAI_API_KEY=
GATEWAY_GOOGLE_API_KEY=

GATEWAY_REQUEST_TIMEOUT_S=30.0
GATEWAY_MAX_ATTEMPTS_PER_PROVIDER=2
GATEWAY_CACHE_TTL_S=3600
GATEWAY_CACHE_MAX_TEMPERATURE=0.0
